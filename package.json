{
  "name": "wa-group-ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Passive WhatsApp group ingestion daemon (Baileys + PostgreSQL + Drizzle)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
